POSTGRES_DB=passafacil
POSTGRES_USER=passafacil
POSTGRES_PASSWORD=change-me-in-production
DATABASE_URL=postgresql+psycopg://passafacil:change-me-in-production@db:5432/passafacil
JWT_SECRET=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:9001,https://passafacil.jussa.com.br
NEXT_PUBLIC_API_URL=http://localhost:9000/api/v1
OWNER_MODE=true
OWNER_EMAIL=juscelino@passafacil.local

# --- Conversão server-side do Google Ads (Google Ads API) ---
# Opcional. Desligado por padrão: enquanto GOOGLE_ADS_ENABLED=false, a conversão
# continua sendo disparada client-side pelo gtag (fallback). Ligue só depois de ter
# o developer token aprovado e o refresh token OAuth (escopo .../auth/adwords).
GOOGLE_ADS_ENABLED=false
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=          # só dígitos, sem hífens (ex.: 6402992934)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=    # conta gerente (MCC), se houver
GOOGLE_ADS_CONVERSION_ACTION_ID= # id numérico da ação de conversão "Compra"

# --- Correção por IA das questões discursivas (cascata de provedores GRATUITOS) ---
# A IA compara a resposta do aluno com o espelho + a grade de critérios e dá a nota
# final. Tenta os provedores na ordem de GRADING_ORDER e cai para o próximo em caso
# de falha/limite. Preencha só as chaves que tiver — provedor sem chave é pulado.
# Sem NENHUMA chave, o app cai automaticamente na autoavaliação manual (nada quebra).
GRADING_ENABLED=true
# Ordem padrão só com provedores 100% grátis e sem cartão. OpenRouter fica fora
# de propósito (ver abaixo). Para incluí-la: GRADING_ORDER=groq,gemini,cerebras,openrouter
GRADING_ORDER=groq,gemini,cerebras
GRADING_TIMEOUT_SECONDS=40
# Groq — camada grátis rápida e generosa, sem cartão: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Google Gemini (endpoint compatível com OpenAI), grátis sem cartão: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# alias "-latest" (contas novas não acessam versões antigas pinadas — dão 404)
GEMINI_MODEL=gemini-flash-latest
# Cerebras — camada grátis, só cadastro: https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b
# OpenRouter — OPCIONAL. Os modelos :free custam US$0, mas a plataforma pede
# crédito/cartão para limites úteis. Só use se quiser; adicione "openrouter" ao
# GRADING_ORDER acima. https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free
