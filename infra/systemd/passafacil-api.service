[Unit]
Description=Passa Facil API (passafacil.jussa.com.br) - FastAPI
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=jussa
Group=jussa
WorkingDirectory=/home/jussa/FileShare/development/passa_facil/apps/api
EnvironmentFile=-/etc/passafacil.env
ExecStart=/home/jussa/FileShare/development/passa_facil/apps/api/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 9000 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
